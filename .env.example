# ── App ──────────────────────────────────────────────────────────────
# Public base URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Pooled connection for serverless runtime
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres
# Direct connection for migrations only
DATABASE_URL_DIRECT=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Secrets ──────────────────────────────────────────────────────────
MAGIC_LINK_SECRET=change-me-32-bytes-random

# ── Inngest ──────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Paystack ─────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=sk_test_xxx

# ── SMS (Hubtel or Arkesel or mock) ──────────────────────────────────
MESSAGING_SMS_PROVIDER=mock
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
ARKESEL_API_KEY=
SMS_SENDER_ID=FIXAM

# ── WhatsApp Cloud API ───────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=FixAm <no-reply@fixam.app>

# ── Web Push (VAPID) ─────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Sentry ───────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed at build time to upload source maps
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
