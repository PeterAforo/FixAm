# ── App ──────────────────────────────────────────────────────────────
# Public base URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server only — required for phone sign-in (creates accounts + sessions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Pooled connection for serverless runtime
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres
# Direct connection for migrations only
DATABASE_URL_DIRECT=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Secrets ──────────────────────────────────────────────────────────
MAGIC_LINK_SECRET=change-me-32-bytes-random

# ── Inngest ──────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Paystack ─────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=sk_test_xxx

# ── SMS (Hubtel or Arkesel or mock) ──────────────────────────────────
# mock = codes appear on screen in local dev only. Set arkesel or hubtel in
# production — phone sign-in, staff invites and broker alerts all use it.
MESSAGING_SMS_PROVIDER=mock
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
ARKESEL_API_KEY=
SMS_SENDER_ID=FIXAM

# ── WhatsApp Cloud API ───────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=FixAm <no-reply@fixam.app>

# ── Web Push (VAPID) ─────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Sentry ───────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed at build time to upload source maps
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Payments: PaySwitch theTeller (P8) ───────────────────────────────
THETELLER_ENV=test
THETELLER_MERCHANT_ID=
THETELLER_API_USER=
THETELLER_API_KEY=
THETELLER_PASS_CODE=

# ── AI + speech (P8) ─────────────────────────────────────────────────
# AI_PROVIDER=claude|mock — falls back to mock when the key is missing
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# USD per million tokens — set to the current published price of ANTHROPIC_MODEL
AI_PRICE_INPUT_PER_MTOK=3
AI_PRICE_OUTPUT_PER_MTOK=15
# SPEECH_PROVIDER=khaya|mock
SPEECH_PROVIDER=mock
KHAYA_API_KEY=
KHAYA_BASE_URL=https://translation-api.ghananlp.org
KHAYA_ASR_PATH=/asr/v1/transcribe
KHAYA_TRANSLATE_PATH=/v1/translate
KHAYA_ASR_PRICE_PER_MIN_USD=0
KHAYA_TRANSLATE_PRICE_PER_KCHAR_USD=0
