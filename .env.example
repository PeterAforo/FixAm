# ── App ──────────────────────────────────────────────────────────────
# Public base URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server only — required for phone sign-in (creates accounts + sessions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Pooled connection for serverless runtime
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres
# Direct connection for migrations only
DATABASE_URL_DIRECT=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Secrets ──────────────────────────────────────────────────────────
# Signs magic links and signed public links. Required in production; generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAGIC_LINK_SECRET=change-me-32-bytes-random
# Signs seasonal-campaign stop links. Optional — falls back to
# PAYOUT_ENCRYPTION_KEY, then a dev default (never safe for production).
LINK_SIGNING_SECRET=
# Shared secret for inbound SMS delivery-status webhooks (POST /api/webhooks/sms).
# Optional but recommended — without it the endpoint accepts unsigned posts.
SMS_WEBHOOK_SECRET=

# ── Inngest ──────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── SMS (Hubtel or Arkesel or mock) ──────────────────────────────────
# mock = codes appear on screen in local dev only. Set arkesel or hubtel in
# production — phone sign-in, staff invites and broker alerts all use it.
MESSAGING_SMS_PROVIDER=mock
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
ARKESEL_API_KEY=
SMS_SENDER_ID=FIXAM

# ── WhatsApp Cloud API ───────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=FixAm <no-reply@fixam.app>

# ── Web Push (VAPID) ─────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Sentry ───────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed at build time to upload source maps
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Payments: PaySwitch theTeller (P8) ───────────────────────────────
# PAYMENT_PROVIDER=theteller|mock — mock is dev/staging only. Production
# checkout + payouts require all four THETELLER_* credentials below.
PAYMENT_PROVIDER=mock
THETELLER_ENV=test
THETELLER_MERCHANT_ID=
THETELLER_API_USER=
THETELLER_API_KEY=
# Float account pass code — needed for vendor/rider payouts and MoMo refunds
THETELLER_PASS_CODE=
# Optional overrides (defaults: test.theteller.net / prod.theteller.net)
THETELLER_API_BASE=
THETELLER_CHECKOUT_URL=
# Optional fallback email on checkout sessions
THETELLER_DEFAULT_EMAIL=
# Encrypts vendor/rider payout accounts and rider Ghana Card numbers at rest —
# any long random string (required in production)
PAYOUT_ENCRYPTION_KEY=
# Phone that gets an SMS when a payout fails or a dispute is opened
ADMIN_ALERT_PHONE=

# ── Deliveries (P8-03) ───────────────────────────────────────────────
# DELIVERY_PROVIDER=manual|mock — manual SMSes ops to book a partner courier
DELIVERY_PROVIDER=manual
DELIVERY_OPS_PHONE=

# ── AI + speech (P8) ─────────────────────────────────────────────────
# AI_PROVIDER=claude|mock — falls back to mock when the key is missing
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# USD per million tokens — set to the current published price of ANTHROPIC_MODEL
AI_PRICE_INPUT_PER_MTOK=3
AI_PRICE_OUTPUT_PER_MTOK=15
# SPEECH_PROVIDER=khaya|mock
SPEECH_PROVIDER=mock
KHAYA_API_KEY=
KHAYA_BASE_URL=https://translation-api.ghananlp.org
KHAYA_ASR_PATH=/asr/v1/transcribe
KHAYA_TRANSLATE_PATH=/v1/translate
KHAYA_ASR_PRICE_PER_MIN_USD=0
KHAYA_TRANSLATE_PRICE_PER_KCHAR_USD=0

# ── Financing / pay-later (P8) ──────────────────────────────────────────────
# FINANCING_PROVIDER=mock|<lender> — plug a real lender into
# lib/integrations/financing.ts when signed. Mock is dev/staging only.
FINANCING_PROVIDER=mock
# Mock lender monthly rate in basis points (400 = 4%)
FINANCING_MOCK_MONTHLY_RATE_BP=400

# ── Support contact (marketing pages) ───────────────────────────────────────
# Optional — shown on public pages; safe defaults are support@fixam.app
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_PHONE=
# Optional canonical site URL fallback (NEXT_PUBLIC_APP_URL is preferred)
NEXT_PUBLIC_SITE_URL=

# ── Playwright e2e (test-only — never set in production) ────────────────────
# PLAYWRIGHT_BASE_URL, PLAYWRIGHT_EMAIL, PLAYWRIGHT_PASSWORD,
# PLAYWRIGHT_GARAGE_SLUG — see tests/e2e/auth.spec.ts
