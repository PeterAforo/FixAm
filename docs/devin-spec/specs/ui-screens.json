      "Quick action '+ Check in' FAB on mobile",
      "Workspace switcher (sidebar top) — jump between garage / parts shop / broker / My cars, or 'Add a workspace' → /onboarding"
    ],
    "auth_routes": {
      "rule": "Clean URLs only — never put ?next= or ?role= on auth/onboarding URLs. The post-login destination is a 30-minute httpOnly cookie 'fixam_next' set by proxy.ts.",
      "routes": {
        "/login": "Sign in only (phone code or e-mail). 'New to FixAm? Create an account' → /signup",
        "/signup": "Public role picker → /signup/<role>",
        "/signup/<role>": "Create account = step 1 of that role (garage|driver|parts-seller|insurance-broker|dvla-agent). On success → /onboarding/<role>",
        "/onboarding": "Signed-in role picker (first setup or 'Add a workspace')",
        "/onboarding/<role>": "Setup wizard for that role",
        "/account": "Workspace hub: open any workspace, add another, sign out"
      },
      "proxy": "Guests on /g, /portal, /vendor, /broker, /account, /admin → /login (+ fixam_next cookie). Guests on /onboarding/<role> → /signup/<role>. Signed-in users on /signup* → /onboarding*. Legacy ?next=/?role= links are rewritten to clean URLs."
    }
  },
  "screens": [
    {
      "id": "dashboard",
      "route": "/g/[garageSlug]",
      "roles": [
        "owner",
        "manager",
        "service_advisor",
        "accountant",
        "storekeeper"
      ],
      "task": "P2-08",
      "content": [
        "Greeting with garage name and date",
        "StatTiles: today's revenue, payments received, jobs in progress, cars ready for pickup",
        "Jobs-by-status mini Kanban counts (tap to filter board)",
        "Ready for pickup list with 'Send pay link' action",
        "Reminders due this week with conversion rate",
        "Low stock list (P3)",
        "Outstanding balances: unpaid invoices, instalments due, credit overdue",
        "7-day revenue sparkline",
        "Quick actions: Check in, New booking, Counter sale, Record expense"
      ],
      "role_variants": {
        "service_advisor": "No profit figures",
        "storekeeper": "Stock-focused tiles"
      }
    },
    {
      "id": "job_board",
      "route": "/g/[garageSlug]/jobs",
      "task": "P1-06",
      "content": [
        "Columns by job status with count badges",
        "Optional swimlanes by bay",
        "Job card: PlateChip, CarAvatar, make/model, customer, complaint snippet, assignee avatars, promised-time countdown (turns warning/danger), priority flag, balance chip when ready",
        "Filters: mechanic, priority, branch, overdue",
        "Drag-and-drop with validation",
        "Realtime"
      ]
    },
    {
      "id": "check_in",
      "route": "/g/[garageSlug]/check-in",
      "task": "P1-05",
      "layout": "Full-screen wizard, tablet-first",
      "steps": [
        "1 Find vehicle by plate or customer by phone (or create)",
        "2 Odometer (number + optional photo) and fuel slider",
        "3 Walk-around photos (front, back, left, right, interior, damage close-ups)",
        "4 Complaint (text + voice note) and items left in car",
        "5 Service template(s), assign mechanic & bay, promised time",
        "6 Review + customer signature",
        "Done screen with confetti-lite and 'Tracker link sent ✅'"
      ]
    },
    {
      "id": "job_detail",
      "route": "/g/[garageSlug]/jobs/[jobId]",
      "task": "P1-05",
      "content": [
        "Header: plate, vehicle, customer (call/WhatsApp buttons), status pill with next-step button",
        "Tabs: Overview, Findings, Estimate & items, Tasks & time, Media, Invoice & payments, Timeline",
        "Side panel: VehicleHealthCard, previous jobs, notes"
