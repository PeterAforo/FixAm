{
  "$schema_version": "1.0",
  "description": "Subscription plans managed by platform admins at /admin/plans (create/edit/deactivate, prices in GHS entered as pesewas in the admin UI; seeded values are placeholders). Plans are scoped to an audience (garage, driver, vendor, broker, tow, rider); every workspace type requires a subscription — 14-day trial, then a monthly payment via theTeller (MoMo or card; no auto-debit). Messages (SMS + WhatsApp) are included as a monthly allowance; push and email do not count against it.",
  "currency": "GHS",
  "billing": {
    "interval": "monthly",
    "provider": "theteller",
    "trial_days": 14,
    "grace_period_days": 7,
    "audiences": ["garage", "driver", "vendor", "broker", "tow", "rider"],
    "past_due_behaviour": "After grace period the workspace becomes read-only until payment succeeds. Garage subscriptions keep the legacy subscriptions table; all other roles use account_subscriptions keyed by (owner_kind, owner_id)."
  },
  "message_units": {
    "sms_segment": 1,
    "whatsapp_utility": 1,
    "whatsapp_authentication": 1,
    "push": 0,
    "email": 0,
    "note": "Units abstract provider cost. A 2-segment SMS counts as 2 units."
  },
