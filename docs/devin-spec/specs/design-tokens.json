{
  "$schema_version": "1.0",
  "name": "Pit Stop Pop",
  "usage": "Expose every token as a CSS variable in app/globals.css (e.g. --color-primary) and map it into the Tailwind theme. Components use Tailwind classes that reference tokens, never raw hex values. All text/background pairs must meet WCAG AA.",
  "color": {
    "brand": {
      "ignition": { "50": "#FFF1EB", "100": "#FFDCCC", "200": "#FFB899", "300": "#FF9366", "400": "#FF7640", "500": "#FF5A1F", "600": "#E64510", "700": "#BF360B", "800": "#992A09", "900": "#7A2208" },
      "midnight": { "50": "#EEF1F8", "100": "#D3DAEB", "200": "#A7B4D6", "300": "#6E81B5", "400": "#3D528C", "500": "#1E3266", "600": "#142650", "700": "#0B1B3F", "800": "#081430", "900": "#050D20" },
