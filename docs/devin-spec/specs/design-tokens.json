      "turbo": { "50": "#E6FAF9", "100": "#BFF2EF", "200": "#85E6E1", "300": "#45D9D1", "400": "#00C2B8", "500": "#00A39B", "600": "#00837C", "700": "#00655F", "800": "#004A46", "900": "#00322F" },
      "cream": "#FFF6EC"
    },
    "semantic_light": {
      "background": "#FFF6EC",
